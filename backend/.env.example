PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/petprint
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:3000
# Used from Phase 4/5 onward — safe to leave empty for now
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=

# Only needed when Cloudinary is NOT configured: used to build absolute URLs
# for images served from this server's /uploads directory.
API_PUBLIC_URL=http://localhost:5000

# Email (Phase 5). Leave blank and notifications are logged to the console
# instead of sent. Gmail requires an App Password, not your account password.
# For a generic SMTP provider set EMAIL_HOST and EMAIL_PORT as well.
EMAIL_FROM=PetPrint <no-reply@yourdomain.com>
EMAIL_HOST=
EMAIL_PORT=587

# AI documentation assistant (Phase 7). Leave blank and the feature is hidden
# entirely — every other part of the app works without it.
# Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
